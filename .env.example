# Shopify Storefront API
# Your permanent .myshopify.com domain (NOT your custom domain)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Private Storefront API Access Token (keep server-only, never expose to client)
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Shopify API Version (quarterly stable version)
SHOPIFY_API_VERSION=2026-07

# Shopify Customer Account API (for headless customer auth)
SHOPIFY_SHOP_ID=
SHOPIFY_CUSTOMER_CLIENT_ID=

# Encrypts the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Your frontend origin (used for OAuth redirect URIs)
# Must be HTTPS with a real hostname or tunnel (e.g. cloudflared / ngrok / Vercel domain)
NEXT_PUBLIC_BASE_URL=https://localhost:3000
